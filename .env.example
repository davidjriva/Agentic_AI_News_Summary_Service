# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── RSS Feed Sources ───────────────────────────────────────────────────────────
# Comma-separated list of RSS feed URLs to ingest
NEWS_SOURCES=https://feeds.feedburner.com/TechCrunch,https://www.theverge.com/rss/index.xml,https://venturebeat.com/feed/,https://www.wired.com/feed/rss,https://feeds.arstechnica.com/arstechnica/index

# ── SMTP / Email Delivery ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM=your_email@gmail.com

# ── Recipients ─────────────────────────────────────────────────────────────────
# Comma-separated list of addresses that will receive each newsletter issue
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# ── Newsletter Settings ────────────────────────────────────────────────────────
MAX_ARTICLES_PER_SECTION=5
NEWSLETTER_TITLE="AI & Tech Weekly Briefing"
NEWSLETTER_TAGLINE="Your curated digest of artificial intelligence and technology news"

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Daily send time in 24-hour HH:MM format (server local time)
SEND_TIME=08:00
