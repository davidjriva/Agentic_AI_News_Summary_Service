ANTHROPIC_API_KEY=your_anthropic_api_key_here
GMAIL_SENDER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_RECIPIENTS=you@example.com,other@example.com

# LLM provider: "anthropic" (default) | "local"
# "local" uses a llama.cpp server via its OpenAI-compatible API
LLM_PROVIDER=anthropic
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=local

# Claude model used when LLM_PROVIDER=anthropic (ignored for local provider)
# Default: claude-sonnet-4-6 — use claude-haiku-4-5-20251001 to reduce cost
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: public-facing URL for the dashboard.
# When set, the newsletter email footer includes a "View Dashboard" link.
# Leave blank to omit the link (default).
DASHBOARD_URL=
