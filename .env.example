ANTHROPIC_API_KEY=your_anthropic_api_key_here
GMAIL_SENDER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_RECIPIENTS=you@example.com,other@example.com

# LLM provider: "anthropic" (default) | "local"
# "local" uses a llama.cpp server via its OpenAI-compatible API
LLM_PROVIDER=anthropic
LOCAL_LLM_URL=http://localhost:8080
LOCAL_LLM_MODEL=local

# Claude model used when LLM_PROVIDER=anthropic (ignored for local provider)
# Default: claude-sonnet-4-6 — use claude-haiku-4-5-20251001 to reduce cost
CLAUDE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Copy these from the Supabase dashboard: Project -> Connect -> Session pooler.
# DB_PASSWORD is your project's database password (kept separate so URL-reserved
# characters are escaped automatically). Tests/CI may instead set DATABASE_URL
# to a full SQLAlchemy URL and the discrete fields below are ignored.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.uiqvdoyzwnsszfnnidqy
SUPABASE_DB_NAME=postgres
DB_PASSWORD=your_supabase_db_password_here
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres   # full override (tests)

# ---------------------------------------------------------------------------
# Newsletter subscriptions
# ---------------------------------------------------------------------------
# Base URL of the portfolio site hosting the subscribe/confirm/unsubscribe
# routes. Used to build per-subscriber unsubscribe links in the newsletter.
PORTFOLIO_BASE_URL=https://your-portfolio-domain.com
