{% extends "_base_admin.html.jinja2" %}

{% block head_title %}Metrics &mdash; The Agentic Times{% endblock %}

{% block masthead_tagline %}AI News &amp; Analysis &nbsp;&middot;&nbsp; Lifetime Metrics{% endblock %}

{% block extra_css %}
    /* ── STAT GRID ──────────────────────────────────── */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 36px;
    }

    .stat-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 24px 20px;
      text-align: center;
    }

    .stat-value {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 36px;
      font-weight: 700;
      color: var(--black);
      line-height: 1;
      margin-bottom: 10px;
    }

    .stat-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
    }

    /* ── CHART ROW ──────────────────────────────────── */
    .chart-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 36px;
    }

    .chart-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 24px;
    }

    .chart-box-title {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 18px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    /* ── FULL CHART ─────────────────────────────────── */
    .chart-full {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 24px;
      margin-bottom: 36px;
    }

    .chart-full-title {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 18px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .chart-empty {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: var(--gray-mid);
      font-style: italic;
      text-align: center;
      padding: 40px 20px;
    }

    /* ── SECTION LABEL SPACING ──────────────────────── */
    .section-label + .section-label,
    .chart-row + .section-label,
    .chart-full + .section-label {
      margin-top: 36px;
    }

    /* ── TOPBAR LABEL ───────────────────────────────── */
    .topbar-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #AAAAAA;
      font-style: italic;
    }

    /* ── RESPONSIVE ─────────────────────────────────── */
    @media (max-width: 640px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
      .chart-row { grid-template-columns: 1fr; }
    }
{% endblock %}

{% block topbar %}
  <div class="topbar">
    <div class="topbar-inner">
      <span class="topbar-label">Pipeline &amp; Content Analytics</span>
    </div>
  </div>
{% endblock %}

{% block main_content %}
    <!-- Lifetime Stats -->
    <h2 class="section-label">
      <span class="section-label-accent">All Time</span>
      Lifetime Stats
    </h2>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-value">{{ emails_delivered }}</div>
        <div class="stat-label">Emails Delivered</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ subscribers }}</div>
        <div class="stat-label">Subscribers</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ total_runs }}</div>
        <div class="stat-label">Total Runs</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ articles_seen }}</div>
        <div class="stat-label">Articles Seen</div>
      </div>
    </div>

    <!-- Content & Pipeline -->
    <h2 class="section-label">
      <span class="section-label-accent">Analysis</span>
      Content &amp; Pipeline
    </h2>

    <div class="chart-row">
      <div class="chart-box">
        <h3 class="chart-box-title">Articles by Source</h3>
        <div id="sourcesEmpty" class="chart-empty" style="display:none;">No articles have been processed yet.</div>
        <canvas id="sourcesChart"></canvas>
      </div>
      <div class="chart-box">
        <h3 class="chart-box-title">Run Success Rate</h3>
        <div id="statusEmpty" class="chart-empty" style="display:none;">No runs completed yet.</div>
        <canvas id="statusChart"></canvas>
      </div>
    </div>

    <!-- Trend -->
    <h2 class="section-label">
      <span class="section-label-accent">Trend</span>
      Articles per Run
    </h2>

    <div class="chart-full">
      <h3 class="chart-full-title">Volume Across Last 20 Successful Runs</h3>
      <div id="trendEmpty" class="chart-empty" style="display:none;">No run data available yet.</div>
      <canvas id="runTrendChart"></canvas>
    </div>
{% endblock %}

{% block scripts %}
  <!-- Chart data -->
  <script>
    const SOURCES_LABELS = {{ sources_labels_json | safe }};
    const SOURCES_DATA   = {{ sources_data_json | safe }};
    const STATUS_LABELS  = {{ run_status_labels_json | safe }};
    const STATUS_DATA    = {{ run_status_data_json | safe }};
    const RUN_DATES      = {{ run_dates_json | safe }};
    const RUN_COUNTS     = {{ run_counts_json | safe }};
  </script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script>
    const EDITORIAL_RED   = '#C41230';
    const EDITORIAL_BLACK = '#121212';
    const EDITORIAL_GRAY  = '#888888';
    const EDITORIAL_LIGHT = '#DEDEDE';

    Chart.defaults.font.family = "'Helvetica Neue', Helvetica, Arial, sans-serif";
    Chart.defaults.color = EDITORIAL_GRAY;

    function showEmptyIfNoData(data, emptyId, canvasId) {
      if (!data || data.length === 0) {
        document.getElementById(emptyId).style.display = 'block';
        document.getElementById(canvasId).style.display = 'none';
        return true;
      }
      return false;
    }

    // Horizontal bar — Articles by Source
    if (!showEmptyIfNoData(SOURCES_DATA, 'sourcesEmpty', 'sourcesChart')) {
      new Chart(document.getElementById('sourcesChart'), {
        type: 'bar',
        data: {
          labels: SOURCES_LABELS,
          datasets: [{
            label: 'Articles',
            data: SOURCES_DATA,
            backgroundColor: SOURCES_DATA.map((_, i) => {
              const palette = [
                '#121212', '#C41230', '#1A3D7A', '#1A5C1A',
                '#7B5B00', '#444444', '#8B1A1A', '#1A4A6B',
                '#2E5E2E', '#5C4A00'
              ];
              return palette[i % palette.length];
            }),
            borderRadius: 0,
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              beginAtZero: true,
              ticks: { precision: 0, color: EDITORIAL_GRAY, font: { size: 11 } },
              grid: { color: EDITORIAL_LIGHT }
            },
            y: {
              ticks: { color: EDITORIAL_BLACK, font: { size: 11, weight: '600' } },
              grid: { display: false }
            }
          }
        }
      });
    }

    // Doughnut — Run Success Rate
    if (!showEmptyIfNoData(STATUS_DATA, 'statusEmpty', 'statusChart')) {
      new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
          labels: STATUS_LABELS,
          datasets: [{
            data: STATUS_DATA,
            backgroundColor: STATUS_LABELS.map(label => {
              if (label === 'success') return '#1A5C1A';
              if (label === 'error')   return EDITORIAL_RED;
              return '#856404';
            }),
            borderWidth: 0,
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { padding: 16, font: { size: 11 }, color: EDITORIAL_BLACK }
            }
          }
        }
      });
    }

    // Line — Articles per Run
    if (!showEmptyIfNoData(RUN_COUNTS, 'trendEmpty', 'runTrendChart')) {
      new Chart(document.getElementById('runTrendChart'), {
        type: 'line',
        data: {
          labels: RUN_DATES,
          datasets: [{
            label: 'Articles',
            data: RUN_COUNTS,
            borderColor: EDITORIAL_BLACK,
            backgroundColor: 'rgba(18,18,18,0.06)',
            fill: true,
            tension: 0.3,
            pointRadius: 4,
            pointBackgroundColor: EDITORIAL_RED,
            pointBorderColor: EDITORIAL_BLACK,
            pointBorderWidth: 1,
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { precision: 0, color: EDITORIAL_GRAY, font: { size: 11 } },
              grid: { color: EDITORIAL_LIGHT }
            },
            x: {
              ticks: { color: EDITORIAL_GRAY, font: { size: 10 }, maxRotation: 45 },
              grid: { display: false }
            }
          }
        }
      });
    }
  </script>
{% endblock %}
