<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Metrics &mdash; The Agentic Times</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --black:      #121212;
      --charcoal:   #333333;
      --red:        #C41230;
      --gray-dark:  #555555;
      --gray-mid:   #888888;
      --gray-light: #CCCCCC;
      --border:     #DEDEDE;
      --bg:         #FFFFFF;
      --bg-warm:    #FDF8F0;
      --bg-section: #F7F7F5;
    }

    body {
      margin: 0;
      padding: 0;
      background: var(--bg-section);
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: var(--black);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── MASTHEAD ───────────────────────────────────── */
    .masthead {
      background: var(--black);
      text-align: center;
    }

    .masthead-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 28px 20px 20px;
    }

    .masthead-eyebrow {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--gray-light);
      margin-bottom: 10px;
    }

    .masthead-rule {
      border: none;
      border-top: 1px solid #3a3a3a;
      margin: 10px auto 14px;
      width: 300px;
    }

    .masthead-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 48px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -1px;
      line-height: 1;
      margin: 0;
    }

    .masthead-tagline {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #999;
      margin-top: 14px;
    }

    /* ── NAV ────────────────────────────────────────── */
    .nav {
      background: var(--black);
      border-bottom: 3px solid var(--red);
    }

    .nav-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
    }

    .nav-tab {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      padding: 11px 16px 10px;
      border-bottom: 3px solid transparent;
      transition: color 0.15s;
    }

    .nav-tab:hover { color: #ccc; }

    .nav-tab.active {
      color: #FFFFFF;
      border-bottom-color: var(--red);
    }

    /* ── PAGE WRAPPER ───────────────────────────────── */
    .page-wrapper {
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }

    /* ── SECTION LABEL ──────────────────────────────── */
    .section-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 20px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--black);
      display: flex;
      align-items: center;
    }

    .section-label + .section-label,
    .chart-row + .section-label,
    .chart-full + .section-label {
      margin-top: 36px;
    }

    .section-label-accent {
      display: inline-block;
      background: var(--red);
      color: #fff;
      font-size: 9px;
      letter-spacing: 1.5px;
      padding: 3px 8px;
      margin-right: 10px;
    }

    /* ── STAT GRID ──────────────────────────────────── */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 36px;
    }

    .stat-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 24px 20px;
      text-align: center;
    }

    .stat-value {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 36px;
      font-weight: 700;
      color: var(--black);
      line-height: 1;
      margin-bottom: 10px;
    }

    .stat-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
    }

    /* ── CHART ROW ──────────────────────────────────── */
    .chart-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 36px;
    }

    .chart-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 24px;
    }

    .chart-box-title {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 18px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    /* ── FULL CHART ─────────────────────────────────── */
    .chart-full {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 24px;
      margin-bottom: 36px;
    }

    .chart-full-title {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 18px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .chart-full-subtitle {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: var(--gray-mid);
      margin: -14px 0 18px 0;
      font-style: italic;
    }

    /* ── FOOTER ─────────────────────────────────────── */
    .footer {
      background: var(--black);
      padding: 24px 20px;
      text-align: center;
    }

    .footer-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .footer p {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #666;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .footer p:last-child { margin-bottom: 0; }
    .footer a { color: #888; text-decoration: none; }
    .footer a:hover { color: #aaa; }

    /* ── RESPONSIVE ─────────────────────────────────── */
    @media (max-width: 640px) {
      .masthead-title { font-size: 32px; }
      .page-wrapper { padding: 20px 16px 40px; }
      .stat-grid { grid-template-columns: repeat(2, 1fr); }
      .chart-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <!-- ── MASTHEAD ─────────────────────────────────────── -->
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-eyebrow">Est. 2026 &nbsp;&middot;&nbsp; Automated Edition</div>
      <hr class="masthead-rule" />
      <h1 class="masthead-title">The Agentic Times</h1>
      <hr class="masthead-rule" />
      <div class="masthead-tagline">AI News &amp; Analysis &nbsp;&middot;&nbsp; Lifetime Metrics</div>
    </div>
  </header>

  <!-- ── NAV ───────────────────────────────────────────── -->
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-tab {% if active == 'dashboard' %}active{% endif %}" href="/">Run History</a>
      <a class="nav-tab {% if active == 'metrics' %}active{% endif %}" href="/metrics">Metrics</a>
    </div>
  </nav>

  <!-- ── CONTENT ───────────────────────────────────────── -->
  <main class="page-wrapper">

    <!-- Lifetime Stats -->
    <h2 class="section-label">
      <span class="section-label-accent">All Time</span>
      Lifetime Stats
    </h2>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-value">{{ emails_delivered }}</div>
        <div class="stat-label">Emails Delivered</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ subscribers }}</div>
        <div class="stat-label">Subscribers</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ total_runs }}</div>
        <div class="stat-label">Total Runs</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ articles_seen }}</div>
        <div class="stat-label">Articles Seen</div>
      </div>
    </div>

    <!-- Content & Pipeline -->
    <h2 class="section-label">
      <span class="section-label-accent">Analysis</span>
      Content &amp; Pipeline
    </h2>

    <div class="chart-row">
      <div class="chart-box">
        <h3 class="chart-box-title">Articles by Source</h3>
        <canvas id="sourcesChart"></canvas>
      </div>
      <div class="chart-box">
        <h3 class="chart-box-title">Run Success Rate</h3>
        <canvas id="statusChart"></canvas>
      </div>
    </div>

    <!-- Trend -->
    <h2 class="section-label">
      <span class="section-label-accent">Trend</span>
      Articles per Run
    </h2>

    <div class="chart-full">
      <h3 class="chart-full-title">Volume Across Last 20 Successful Runs</h3>
      <p class="chart-full-subtitle">Articles ranked and published per edition</p>
      <canvas id="runTrendChart"></canvas>
    </div>

  </main>

  <!-- ── FOOTER ────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer-inner">
      <p>The Agentic Times &mdash; Automated AI News Digest</p>
      <p>Pipeline Dashboard</p>
    </div>
  </footer>

  <!-- Chart data -->
  <script>
    const SOURCES_LABELS = {{ sources_labels_json | safe }};
    const SOURCES_DATA   = {{ sources_data_json | safe }};
    const STATUS_LABELS  = {{ run_status_labels_json | safe }};
    const STATUS_DATA    = {{ run_status_data_json | safe }};
    const RUN_DATES      = {{ run_dates_json | safe }};
    const RUN_COUNTS     = {{ run_counts_json | safe }};
  </script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script>
    const EDITORIAL_RED   = '#C41230';
    const EDITORIAL_BLACK = '#121212';
    const EDITORIAL_GRAY  = '#888888';
    const EDITORIAL_LIGHT = '#DEDEDE';

    Chart.defaults.font.family = "'Helvetica Neue', Helvetica, Arial, sans-serif";
    Chart.defaults.color = EDITORIAL_GRAY;

    // Horizontal bar — Articles by Source
    new Chart(document.getElementById('sourcesChart'), {
      type: 'bar',
      data: {
        labels: SOURCES_LABELS,
        datasets: [{
          label: 'Articles',
          data: SOURCES_DATA,
          backgroundColor: EDITORIAL_BLACK,
          borderRadius: 0,
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: {
            beginAtZero: true,
            ticks: { precision: 0, color: EDITORIAL_GRAY, font: { size: 11 } },
            grid: { color: EDITORIAL_LIGHT }
          },
          y: {
            ticks: { color: EDITORIAL_BLACK, font: { size: 11, weight: '600' } },
            grid: { display: false }
          }
        }
      }
    });

    // Doughnut — Run Success Rate
    new Chart(document.getElementById('statusChart'), {
      type: 'doughnut',
      data: {
        labels: STATUS_LABELS,
        datasets: [{
          data: STATUS_DATA,
          backgroundColor: STATUS_LABELS.map(label => {
            if (label === 'success') return '#1A5C1A';
            if (label === 'error')   return EDITORIAL_RED;
            return '#856404';
          }),
          borderWidth: 0,
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { padding: 16, font: { size: 11 }, color: EDITORIAL_BLACK }
          }
        }
      }
    });

    // Line — Articles per Run
    new Chart(document.getElementById('runTrendChart'), {
      type: 'line',
      data: {
        labels: RUN_DATES,
        datasets: [{
          label: 'Articles',
          data: RUN_COUNTS,
          borderColor: EDITORIAL_BLACK,
          backgroundColor: 'rgba(18,18,18,0.06)',
          fill: true,
          tension: 0.3,
          pointRadius: 4,
          pointBackgroundColor: EDITORIAL_RED,
          pointBorderColor: EDITORIAL_BLACK,
          pointBorderWidth: 1,
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { precision: 0, color: EDITORIAL_GRAY, font: { size: 11 } },
            grid: { color: EDITORIAL_LIGHT }
          },
          x: {
            ticks: { color: EDITORIAL_GRAY, font: { size: 10 }, maxRotation: 45 },
            grid: { display: false }
          }
        }
      }
    });
  </script>
</body>
</html>
