<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block head_title %}The Agentic Times{% endblock %}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --black:       #121212;
      --charcoal:    #333333;
      --red:         #C41230;
      --gray-dark:   #555555;
      --gray-mid:    #888888;
      --gray-light:  #CCCCCC;
      --border:      #DEDEDE;
      --bg:          #FFFFFF;
      --bg-warm:     #FDF8F0;
      --bg-section:  #F7F7F5;
    }

    body {
      margin: 0;
      padding: 0;
      background: var(--bg-section);
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: var(--black);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── MASTHEAD ───────────────────────────────────── */
    .masthead {
      background: var(--black);
      text-align: center;
    }

    .masthead-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 28px 20px 20px;
    }

    .masthead-eyebrow {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--gray-light);
      margin-bottom: 10px;
    }

    .masthead-rule {
      border: none;
      border-top: 1px solid #3a3a3a;
      margin: 10px auto 14px;
      width: 300px;
    }

    .masthead-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 48px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -1px;
      line-height: 1;
      margin: 0;
    }

    .masthead-tagline {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #999;
      margin-top: 14px;
    }

    /* ── TOP BAR ────────────────────────────────────── */
    .topbar {
      background: var(--black);
      border-top: 1px solid #222;
      border-bottom: 3px solid var(--red);
    }

    .topbar-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 8px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* ── NAV ────────────────────────────────────────── */
    .nav {
      background: var(--black);
      border-bottom: 1px solid #222;
    }

    .nav-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
    }

    .nav-tab {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      padding: 11px 16px 10px;
      border-bottom: 3px solid transparent;
      transition: color 0.15s;
    }

    .nav-tab:hover { color: #ccc; }

    .nav-tab.active {
      color: #FFFFFF;
      border-bottom-color: var(--red);
    }

    /* ── PAGE WRAPPER ───────────────────────────────── */
    .page-wrapper {
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }

    /* ── SECTION LABEL ──────────────────────────────── */
    .section-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 20px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--black);
      display: flex;
      align-items: center;
    }

    .section-label-accent {
      display: inline-block;
      background: var(--red);
      color: #fff;
      font-size: 9px;
      letter-spacing: 1.5px;
      padding: 3px 8px;
      margin-right: 10px;
    }

    /* ── FOOTER ─────────────────────────────────────── */
    .footer {
      background: var(--black);
      padding: 24px 20px;
      text-align: center;
    }

    .footer-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .footer p {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #666;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .footer p:last-child { margin-bottom: 0; }
    .footer a { color: #888; text-decoration: none; }
    .footer a:hover { color: #aaa; }

    /* ── SHARED RESPONSIVE BASE ─────────────────────── */
    @media (max-width: 640px) {
      .masthead-title { font-size: 32px; }
      .page-wrapper { padding: 20px 16px 40px; }
    }

    {% block extra_css %}{% endblock %}
  </style>
</head>
<body>

  <!-- ── MASTHEAD ─────────────────────────────────────── -->
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-eyebrow">Est. 2026 &nbsp;&middot;&nbsp; Automated Edition</div>
      <hr class="masthead-rule" />
      <h1 class="masthead-title">The Agentic Times</h1>
      <hr class="masthead-rule" />
      <div class="masthead-tagline">{% block masthead_tagline %}AI News &amp; Analysis{% endblock %}</div>
    </div>
  </header>

  <!-- ── TOP BAR ───────────────────────────────────────── -->
  {% block topbar %}{% endblock %}

  <!-- ── NAV ───────────────────────────────────────────── -->
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-tab {% if active == 'dashboard' %}active{% endif %}" href="/">Run History</a>
      <a class="nav-tab {% if active == 'metrics' %}active{% endif %}" href="/metrics">Metrics</a>
    </div>
  </nav>

  <!-- ── CONTENT ───────────────────────────────────────── -->
  <main class="page-wrapper">
    {% block main_content %}{% endblock %}
  </main>

  <!-- ── FOOTER ────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer-inner">
      <p>The Agentic Times &mdash; Automated AI News Digest</p>
      <p><a href="/">Dashboard Home</a></p>
    </div>
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>
