<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>The Agentic Times</title>
  <style>
    /* Reset */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      width: 100% !important;
      background-color: #F7F7F5;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #121212;
      line-height: 1.6;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table { border-spacing: 0; border-collapse: collapse; }
    img { border: 0; height: auto; outline: none; text-decoration: none; }
    a { color: #C41230; text-decoration: none; }

    /* ── WRAPPER ────────────────────────────────────── */
    .wrapper {
      width: 100%;
      background-color: #F7F7F5;
      padding: 24px 0 40px;
    }

    .main {
      width: 100%;
      max-width: 640px;
      margin: 0 auto;
    }

    /* ── MASTHEAD ───────────────────────────────────── */
    .masthead-table {
      width: 100%;
      background-color: #121212;
    }

    .masthead-eyebrow {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #888;
      text-align: center;
      padding: 20px 24px 8px;
      display: block;
    }

    .masthead-rule-top {
      border: none;
      border-top: 1px solid #3a3a3a;
      margin: 0 auto 14px;
      width: 260px;
      display: block;
    }

    .masthead-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 42px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -1px;
      line-height: 1;
      text-align: center;
      display: block;
      margin: 0;
    }

    .masthead-rule-bottom {
      border: none;
      border-top: 1px solid #3a3a3a;
      margin: 14px auto 12px;
      width: 260px;
      display: block;
    }

    .masthead-tagline {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #888;
      text-align: center;
      display: block;
      padding-bottom: 20px;
    }

    /* ── RED RULE BELOW MASTHEAD ─────────────────────── */
    .masthead-red-rule {
      width: 100%;
      height: 3px;
      background-color: #C41230;
      display: block;
    }

    /* ── EDITION INFO ───────────────────────────────── */
    .edition-bar {
      width: 100%;
      background-color: #121212;
      border-bottom: 1px solid #222;
    }

    .edition-bar-inner {
      padding: 8px 24px;
      display: table;
      width: 100%;
    }

    .edition-date {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #AAAAAA;
      font-style: italic;
      display: table-cell;
      vertical-align: middle;
    }

    .edition-number {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      background-color: #C41230;
      color: #fff;
      padding: 3px 9px;
      display: table-cell;
      vertical-align: middle;
      text-align: right;
      white-space: nowrap;
    }

    /* ── INTRO ──────────────────────────────────────── */
    .intro-row {
      padding: 18px 32px 16px;
      background-color: #fff;
      border-bottom: 1px solid #DEDEDE;
    }
    .intro-date-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #C41230;
      display: block;
      margin-bottom: 4px;
    }
    .intro-headline {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 14px;
      color: #333;
      line-height: 1.5;
    }
    .intro-headline strong {
      color: #121212;
    }

    /* ── TABLE OF CONTENTS ─────────────────────── */
    .toc-section {
      background-color: #FAFAF8;
      border-bottom: 2px solid #DEDEDE;
      padding: 20px 32px 24px;
    }
    .toc-header {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid #DEDEDE;
    }
    .toc-item {
      padding: 7px 0;
      border-bottom: 1px solid #F0F0F0;
      display: table;
      width: 100%;
    }
    .toc-item:last-child {
      border-bottom: none;
    }
    .toc-rank {
      display: table-cell;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      color: #C41230;
      width: 28px;
      vertical-align: top;
      padding-top: 2px;
    }
    .toc-title {
      display: table-cell;
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 13px;
      line-height: 1.4;
      color: #121212;
      vertical-align: top;
    }
    .toc-title a {
      color: #121212;
      text-decoration: none;
    }
    .toc-pub {
      display: table-cell;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      color: #888;
      white-space: nowrap;
      vertical-align: top;
      padding-top: 2px;
      padding-left: 12px;
      text-align: right;
    }

    /* ── ARTICLE CARD ───────────────────────────────── */
    .article-card {
      width: 100%;
      background-color: #FFFFFF;
      border-bottom: 1px solid #DEDEDE;
    }

    .article-card:first-of-type .article-inner {
      padding-top: 28px;
    }

    .article-inner {
      padding: 24px 32px 28px;
    }

    /* Featured top story */
    .article-card-featured {
      width: 100%;
      background-color: #FFFFFF;
      border-bottom: 1px solid #DEDEDE;
      border-left: 4px solid #C41230;
    }
    .article-card-featured .article-headline {
      font-size: 26px;
    }
    .top-story-badge {
      display: inline-block;
      background-color: #C41230;
      color: #ffffff;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 3px 8px;
      margin-bottom: 12px;
    }

    /* Rank + publication bar */
    .article-topbar {
      margin-bottom: 14px;
      border-bottom: 1px solid #DEDEDE;
      padding-bottom: 12px;
      width: 100%;
    }
    .article-topbar-table {
      width: 100%;
      border-collapse: collapse;
    }
    .article-topbar-rank-cell {
      vertical-align: middle;
      white-space: nowrap;
      padding-right: 10px;
      width: 1%;
    }
    .article-topbar-divider-cell {
      vertical-align: middle;
      width: 1px;
      padding: 0 10px 0 0;
    }
    .article-topbar-pub-cell {
      vertical-align: middle;
    }
    .article-topbar-date-cell {
      vertical-align: middle;
      white-space: nowrap;
      text-align: right;
    }

    .article-rank {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 28px;
      font-weight: 700;
      color: #C41230;
      line-height: 1;
      min-width: 32px;
    }

    .article-rank-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #888;
      display: block;
    }

    .article-topbar-divider {
      width: 1px;
      height: 32px;
      background: #DEDEDE;
    }

    .article-publication {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #121212;
    }

    .article-pub-date {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #888;
      white-space: nowrap;
    }

    /* Headline */
    .article-headline {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 22px;
      font-weight: 700;
      line-height: 1.3;
      color: #121212;
      margin-bottom: 10px;
    }

    .article-headline a {
      color: #121212;
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }

    .article-headline a:hover {
      border-bottom-color: #121212;
    }

    /* Byline (dek style) */
    .article-byline {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #555;
      margin-bottom: 14px;
      font-style: italic;
    }

    /* Summary */
    .article-summary {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 14px;
      line-height: 1.7;
      color: #333;
      margin-bottom: 18px;
    }

    /* Scores */
    .article-scores {
      padding-top: 14px;
      border-top: 1px solid #F0F0F0;
      font-size: 0; /* collapse whitespace between inline-blocks */
    }

    .score-item {
      display: inline-block;
      vertical-align: top;
      margin-right: 24px;
      font-size: 14px; /* reset font-size */
    }

    .score-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #888;
    }

    .score-value {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 15px;
      font-weight: 700;
    }

    .score-relevance     { color: #1A3D7A; }
    .score-impact        { color: #1A5C1A; }
    .score-authenticity  { color: #7B5B00; }
    .score-rankscore     { color: #4A1D7A; }

    /* Read more link */
    .article-readmore {
      margin-top: 16px;
      display: block;
    }

    .article-readmore a {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #C41230;
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }

    .article-readmore a:hover {
      border-bottom-color: #C41230;
    }

    /* Section break between articles */
    .article-separator {
      width: 100%;
      height: 1px;
      background: #DEDEDE;
    }

    /* ── FOOTER ─────────────────────────────────────── */
    .footer-table {
      width: 100%;
      background-color: #121212;
    }

    .footer-inner {
      padding: 28px 32px;
      text-align: center;
    }

    .footer-brand {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 16px;
      font-weight: 700;
      color: #fff;
      display: block;
      margin-bottom: 8px;
      letter-spacing: -0.3px;
    }

    .footer-meta {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #666;
      display: block;
      margin-bottom: 5px;
      letter-spacing: 0.3px;
    }

    .footer-meta a { color: #888; text-decoration: none; }
    .footer-meta a:hover { color: #aaa; }

    .footer-rule {
      border: none;
      border-top: 1px solid #2a2a2a;
      margin: 16px auto;
      width: 200px;
    }

    /* ── RESPONSIVE ─────────────────────────────────── */
    @media only screen and (max-width: 620px) {
      .main { width: 100% !important; }
      .masthead-title { font-size: 30px !important; }
      .article-inner { padding: 16px !important; }
      .toc-section { padding: 16px !important; }
      .article-headline { font-size: 19px !important; }
      .article-card-featured .article-headline { font-size: 22px !important; }
      .article-summary { font-size: 13px !important; }
      .article-rank { font-size: 22px !important; }
      .score-item { margin-right: 14px !important; }
      .toc-pub { display: none !important; }
    }
  </style>
</head>
<body>
  <center>
    <div class="wrapper">
      <table class="main" cellpadding="0" cellspacing="0">

        <!-- ── MASTHEAD ──────────────────────────────── -->
        <tr>
          <td>
            <table class="masthead-table" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td align="center" style="padding: 20px 24px 0;">
                  <span class="masthead-eyebrow">Est. 2026 &nbsp;&middot;&nbsp; Automated Edition</span>
                </td>
              </tr>
              <tr>
                <td align="center" style="padding: 0 24px;">
                  <hr class="masthead-rule-top" />
                </td>
              </tr>
              <tr>
                <td align="center" style="padding: 0 24px;">
                  <h1 class="masthead-title">The Agentic Times</h1>
                </td>
              </tr>
              <tr>
                <td align="center" style="padding: 0 24px;">
                  <hr class="masthead-rule-bottom" />
                </td>
              </tr>
              <tr>
                <td align="center" style="padding: 0 24px 20px;">
                  <span class="masthead-tagline">AI News &amp; Analysis</span>
                </td>
              </tr>
            </table>
            <div class="masthead-red-rule"></div>
          </td>
        </tr>

        <!-- ── EDITION BAR ───────────────────────────── -->
        <tr>
          <td>
            <div class="edition-bar">
              <div class="edition-bar-inner">
                <span class="edition-date">{{ run_time.strftime('%A, %B %-d, %Y at %H:%M UTC') }}</span>
                <span class="edition-number">Edition #{{ run_id[:6] if run_id else '000001' }}</span>
              </div>
            </div>
          </td>
        </tr>

        <!-- ── INTRO ─────────────────────────────────── -->
        <tr>
          <td>
            <div class="intro-row">
              <span class="intro-date-label">{{ run_time.strftime('%A, %B %-d, %Y') }}</span>
              <span class="intro-headline">
                Today's digest features <strong>{{ article_count }} article{{ 's' if article_count != 1 else '' }}</strong>
                curated from across the AI landscape and ranked by impact and authenticity.
              </span>
            </div>
          </td>
        </tr>

        <!-- ── TABLE OF CONTENTS ─────────────────────── -->
        <tr>
          <td>
            <div class="toc-section">
              <div class="toc-header">In This Edition</div>
              {% for article in articles %}
              <div class="toc-item">
                <span class="toc-rank">{{ loop.index }}</span>
                <span class="toc-title"><a href="{{ article.url }}">{{ article.title }}</a></span>
                <span class="toc-pub">{{ article.publication }}</span>
              </div>
              {% endfor %}
            </div>
          </td>
        </tr>

        <!-- ── ARTICLES ──────────────────────────────── -->
        {% for article in articles %}
        <tr>
          <td>
            <div class="{% if loop.first %}article-card-featured{% else %}article-card{% endif %}">
              <div class="article-inner">

                {% if loop.first %}
                <div class="top-story-badge">Top Story</div>
                {% endif %}

                <!-- Rank + Publication -->
                <div class="article-topbar">
                  <table class="article-topbar-table" cellpadding="0" cellspacing="0">
                    <tr>
                      <td class="article-topbar-rank-cell">
                        <span class="article-rank">#{{ loop.index }}</span>
                        <span class="article-rank-label">Rank</span>
                      </td>
                      <td class="article-topbar-divider-cell">
                        <div class="article-topbar-divider"></div>
                      </td>
                      <td class="article-topbar-pub-cell">
                        <span class="article-publication">{{ article.publication }}</span>
                      </td>
                      <td class="article-topbar-date-cell">
                        <span class="article-pub-date">{% if article.published_at %}{{ article.published_at.strftime('%b %-d, %Y') }}{% endif %}</span>
                      </td>
                    </tr>
                  </table>
                </div>

                <!-- Headline -->
                <h2 class="article-headline">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h2>

                <!-- Byline -->
                {% if article.author %}
                <p class="article-byline">By {{ article.author }}</p>
                {% endif %}

                <!-- Summary -->
                <p class="article-summary">{{ article.summary }}</p>

                <!-- Scores + Read More -->
                <div class="article-scores">
                  <div class="score-item">
                    <span class="score-label" title="LLM-scored 1–10. How on-topic the article is for agentic AI/ML. Articles scoring below 6 are filtered out before ranking.">Relevance</span>
                    <span class="score-value score-relevance">{{ article.relevance_score if article.relevance_score is not none else '?' }}<span style="font-size:11px;color:#888;">/10</span></span>
                  </div>
                  <div class="score-item">
                    <span class="score-label" title="LLM-scored 1–10. Measures the article's significance and potential impact on the AI field. Weighted 60% in rank score.">Impact</span>
                    <span class="score-value score-impact">{{ article.impact_score }}<span style="font-size:11px;color:#888;">/10</span></span>
                  </div>
                  <div class="score-item">
                    <span class="score-label" title="LLM-scored 1–10. Measures the article's credibility and factual grounding. Weighted 40% in rank score.">Authenticity</span>
                    <span class="score-value score-authenticity">{{ article.authenticity_score }}<span style="font-size:11px;color:#888;">/10</span></span>
                  </div>
                  <div class="score-item">
                    <span class="score-label" title="Composite ranking score: (Impact × 0.6) + (Authenticity × 0.4)">Rank Score</span>
                    <span class="score-value score-rankscore">{{ "%.1f"|format(article.rank_score) if article.rank_score is not none else '?' }}<span style="font-size:11px;color:#888;">/10</span></span>
                  </div>
                </div>

                <div class="article-readmore">
                  <a href="{{ article.url }}">Read Full Article &rarr;</a>
                </div>

              </div>
            </div>
          </td>
        </tr>
        {% if not loop.last %}
        <tr><td><div class="article-separator"></div></td></tr>
        {% endif %}
        {% endfor %}

        <!-- ── FOOTER ────────────────────────────────── -->
        <tr>
          <td>
            <table class="footer-table" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td>
                  <div class="footer-inner">
                    <span class="footer-brand">The Agentic Times</span>
                    <hr class="footer-rule" />
                    <span class="footer-meta">Automated AI News &amp; Analysis</span>
                    <span class="footer-meta">Generated {{ run_time.strftime('%Y-%m-%d at %H:%M UTC') }}</span>
                    <span class="footer-meta" style="margin-top:8px; color:#555;">
                      This digest is automatically generated by The Agentic Times pipeline.
                    </span>
                    <span class="footer-meta" style="margin-top:12px; font-size:10px; color:#444;">
                      You received this because you are subscribed to The Agentic Times.
                    </span>
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </div>
  </center>
</body>
</html>
