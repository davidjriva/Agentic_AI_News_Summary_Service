<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edition {{ started_at[:10] if started_at else run_id[:8] }} &mdash; The Agentic Times</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --black:      #121212;
      --charcoal:   #333333;
      --red:        #C41230;
      --gray-dark:  #555555;
      --gray-mid:   #888888;
      --gray-light: #CCCCCC;
      --border:     #DEDEDE;
      --bg:         #FFFFFF;
      --bg-warm:    #FDF8F0;
      --bg-section: #F7F7F5;
    }

    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: var(--black);
      background: var(--bg-section);
      -webkit-font-smoothing: antialiased;
    }

    /* ── MASTHEAD ───────────────────────────────────── */
    .masthead {
      background: var(--black);
      text-align: center;
      flex-shrink: 0;
    }

    .masthead-inner {
      max-width: 100%;
      padding: 16px 20px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .masthead-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .masthead-back {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      transition: color 0.15s;
    }

    .masthead-back:hover { color: #ccc; }

    .masthead-sep {
      color: #444;
      font-size: 14px;
    }

    .masthead-brand {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.5px;
    }

    .masthead-edition {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #888;
      letter-spacing: 0.5px;
    }

    .masthead-ts {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #666;
    }

    /* ── NAV ────────────────────────────────────────── */
    .nav {
      background: var(--black);
      border-top: 1px solid #222;
      border-bottom: 3px solid var(--red);
      flex-shrink: 0;
    }

    .nav-inner {
      padding: 0 20px;
      display: flex;
    }

    .nav-tab {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      padding: 10px 16px 9px;
      border-bottom: 3px solid transparent;
      transition: color 0.15s;
    }

    .nav-tab:hover { color: #ccc; }

    .nav-tab.active {
      color: #fff;
      border-bottom-color: var(--red);
    }

    /* ── LAYOUT ─────────────────────────────────────── */
    .layout-wrapper {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    .layout {
      display: flex;
      flex: 1;
      min-height: 0;
    }

    /* ── NEWSLETTER PANE ─────────────────────────────── */
    .newsletter-pane {
      flex: 1 1 0;
      min-width: 0;
    }

    .newsletter-pane iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    /* ── SIDEBAR ────────────────────────────────────── */
    .sidebar {
      width: 300px;
      flex-shrink: 0;
      background: var(--bg);
      border-left: 1px solid var(--border);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar-header {
      background: var(--black);
      padding: 16px 20px;
      position: sticky;
      top: 0;
      z-index: 1;
      border-bottom: 2px solid var(--red);
    }

    .sidebar-header-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 3px 0;
    }

    .sidebar-header-meta {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #888;
    }

    .sidebar-body {
      padding: 16px;
      flex: 1;
    }

    /* ── SOURCE GROUPS ──────────────────────────────── */
    .source-group {
      margin-bottom: 20px;
    }

    .source-group:last-child { margin-bottom: 0; }

    .source-name {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--black);
      margin: 0 0 8px 0;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .source-count {
      background: var(--red);
      color: #fff;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 6px;
      letter-spacing: 0.5px;
    }

    .article-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .article-list li {
      margin-bottom: 6px;
      font-size: 12px;
      line-height: 1.4;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .article-score {
      flex-shrink: 0;
      font-size: 10px;
      font-weight: 600;
      color: var(--gray-mid);
      font-variant-numeric: tabular-nums;
    }

    .article-list a {
      color: var(--charcoal);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s, color 0.15s;
    }

    .article-list a:hover {
      color: var(--red);
      border-bottom-color: var(--red);
    }

    /* ── EMPTY STATE ────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 40px 16px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: var(--gray-mid);
      font-style: italic;
    }

    /* ── FILTER/FAIL SECTIONS ───────────────────────── */
    .sidebar-section-header {
      background: var(--bg-section);
      padding: 12px 20px 10px;
      border-top: 2px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .sidebar-section-title {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0;
    }

    .filtered-list,
    .failed-list {
      margin: 0;
      padding: 12px 16px;
      list-style: none;
    }

    .filtered-list li,
    .failed-list li {
      margin-bottom: 10px;
      font-size: 11px;
      line-height: 1.4;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .filtered-list li:last-child,
    .failed-list li:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .filter-title {
      color: var(--charcoal);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s, color 0.15s;
    }

    .filter-title:hover {
      color: var(--red);
      border-bottom-color: var(--red);
    }

    .filter-meta {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      color: var(--gray-mid);
      margin-top: 3px;
    }

    .filter-score {
      display: inline-block;
      background: #FDE8E8;
      color: #921818;
      font-size: 9px;
      font-weight: 700;
      padding: 1px 5px;
      letter-spacing: 0.5px;
      margin-right: 4px;
    }

    .fail-reason {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      color: #921818;
      margin-top: 3px;
      font-style: italic;
    }

    /* ── SKELETON LOADERS ──────────────────────────── */
    .skeleton-item { padding: 6px 0; list-style: none; }
    .skeleton-line {
      height: 10px;
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: 2px;
      margin-bottom: 6px;
    }
    .skeleton-line-long { width: 85%; }
    .skeleton-line-short { width: 50%; }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* ── SOURCE TOGGLE ──────────────────────────────── */
    .source-toggle { font-size: 10px; color: var(--gray-mid); transition: transform 0.15s; display: inline-block; }
    .source-name.collapsed .source-toggle { transform: rotate(-90deg); }

    /* ── PREVIEW BANNER ─────────────────────────────── */
    .preview-banner {
      background: #FFF3CD;
      border-bottom: 1px solid #FFECB5;
      color: #856404;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      font-weight: 600;
      text-align: center;
      padding: 6px 20px;
      letter-spacing: 0.3px;
    }

    .newsletter-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      background: var(--bg-section);
      color: var(--gray-mid);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="layout-wrapper">

    <!-- ── MASTHEAD ─────────────────────────────────── -->
    <header class="masthead">
      <div class="masthead-inner">
        <div class="masthead-left">
          <a class="masthead-back" href="/">&larr; Dashboard</a>
          <span class="masthead-sep">/</span>
          <span class="masthead-brand">The Agentic Times</span>
          {% if started_at %}
          <span class="masthead-edition">{{ started_at[:10] }}</span>
          {% else %}
          <span class="masthead-edition">{{ run_id[:8] }}&hellip;</span>
          {% endif %}
        </div>
        {% if started_at %}
        <span class="masthead-ts">{{ started_at }}</span>
        {% endif %}
      </div>
    </header>

    <!-- ── NAV ─────────────────────────────────────── -->
    <nav class="nav">
      <div class="nav-inner">
        <a class="nav-tab" href="/">Run History</a>
        <a class="nav-tab" href="/metrics">Metrics</a>
      </div>
    </nav>

    {% if preview %}
    <div class="preview-banner">Preview Mode &mdash; fake data</div>
    {% endif %}

    <!-- ── SPLIT LAYOUT ─────────────────────────────── -->
    <div class="layout">

      <!-- Newsletter iframe -->
      <div class="newsletter-pane">
        {% if preview %}
        <iframe src="/preview/newsletter" title="Newsletter Edition"></iframe>
        {% else %}
        <iframe src="/runs/{{ run_id }}/newsletter" title="Newsletter Edition"></iframe>
        {% endif %}
      </div>

      <!-- Sources sidebar -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <h2 class="sidebar-header-title">Articles by Source</h2>
          <p class="sidebar-header-meta">
            {{ sources | length }} source{{ 's' if sources | length != 1 else '' }}
            &nbsp;·&nbsp;
            {{ sources.values() | map('length') | sum }} articles fetched
          </p>
        </div>

        <div class="sidebar-body">
          {% if sources %}
            {% for publication, articles in sources.items() %}
            <div class="source-group">
              <h3 class="source-name" onclick="toggleSource(this)" style="cursor:pointer;">
                <span>{{ publication }}</span>
                <span style="display:flex;align-items:center;gap:6px;">
                  <span class="source-count">{{ articles | length }}</span>
                  <span class="source-toggle">&#9662;</span>
                </span>
              </h3>
              <ul class="article-list">
                {% for article in articles %}
                <li>
                  {% if article.rank_score is not none %}<span class="article-score">{{ "%.1f"|format(article.rank_score) }}</span>{% endif %}
                  <a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a>
                </li>
                {% endfor %}
              </ul>
            </div>
            {% endfor %}
          {% else %}
            <div class="empty-state">No article data for this edition.</div>
          {% endif %}
        </div>

        <!-- Filtered (dropped) articles section -->
        <div class="sidebar-section-header">
          <h3 class="sidebar-section-title" id="filtered-header">Dropped &mdash; Low Relevance</h3>
        </div>
        <ul class="filtered-list" id="filtered-list">
          <li class="skeleton-item">
            <div class="skeleton-line skeleton-line-long"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </li>
          <li class="skeleton-item">
            <div class="skeleton-line skeleton-line-long"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </li>
        </ul>

        <!-- Failed articles section -->
        <div class="sidebar-section-header">
          <h3 class="sidebar-section-title" id="failed-header">Failed &mdash; Processing Errors</h3>
        </div>
        <ul class="failed-list" id="failed-list">
          <li class="skeleton-item">
            <div class="skeleton-line skeleton-line-long"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </li>
          <li class="skeleton-item">
            <div class="skeleton-line skeleton-line-long"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </li>
        </ul>
      </aside>

    </div>
  </div>

  <script>
    const RUN_ID = "{{ run_id }}";

    function renderFiltered(items) {
      const list = document.getElementById('filtered-list');
      const header = document.getElementById('filtered-header');
      if (header) header.textContent = `Dropped — Low Relevance (${items ? items.length : 0})`;
      if (!items || items.length === 0) {
        list.innerHTML = '<li style="text-align:center;font-family:\'Helvetica Neue\',sans-serif;font-size:11px;color:var(--gray-mid);font-style:italic;">None dropped this run.</li>';
        return;
      }
      list.innerHTML = items.map(a => `
        <li>
          <a class="filter-title" href="${a.url || '#'}" target="_blank" rel="noopener">${a.title || '(no title)'}</a>
          <div class="filter-meta">
            <span class="filter-score">Score ${a.relevance_score !== null ? a.relevance_score : '?'}</span>
            ${a.publication ? a.publication : ''}
          </div>
          ${a.relevance_reason ? `<div class="filter-meta">${a.relevance_reason}</div>` : ''}
        </li>
      `).join('');
    }

    function renderFailed(items) {
      const list = document.getElementById('failed-list');
      const header = document.getElementById('failed-header');
      if (header) header.textContent = `Failed — Processing Errors (${items ? items.length : 0})`;
      if (!items || items.length === 0) {
        list.innerHTML = '<li style="text-align:center;font-family:\'Helvetica Neue\',sans-serif;font-size:11px;color:var(--gray-mid);font-style:italic;">No failures this run.</li>';
        return;
      }
      list.innerHTML = items.map(a => `
        <li>
          <a class="filter-title" href="${a.url || '#'}" target="_blank" rel="noopener">${a.title || '(no title)'}</a>
          <div class="filter-meta">${a.publication ? a.publication : ''}</div>
          ${a.reason ? `<div class="fail-reason">${a.reason}</div>` : ''}
        </li>
      `).join('');
    }

    function toggleSource(nameEl) {
      const group = nameEl.parentElement;
      const list = group.querySelector('.article-list');
      const collapsed = nameEl.classList.toggle('collapsed');
      list.style.display = collapsed ? 'none' : '';
    }

    {% if preview %}
    renderFiltered([]);
    renderFailed([]);
    {% else %}
    document.addEventListener('DOMContentLoaded', () => {
      fetch(`/runs/${RUN_ID}/filtered`)
        .then(r => r.json())
        .then(data => renderFiltered(data.filtered))
        .catch(() => renderFiltered([]));

      fetch(`/runs/${RUN_ID}/failed`)
        .then(r => r.json())
        .then(data => renderFailed(data.failed))
        .catch(() => renderFailed([]));
    });
    {% endif %}
  </script>
</body>
</html>
