<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edition {{ run_id[:8] }} &mdash; The Agentic Times</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --black:      #121212;
      --charcoal:   #333333;
      --red:        #C41230;
      --gray-dark:  #555555;
      --gray-mid:   #888888;
      --gray-light: #CCCCCC;
      --border:     #DEDEDE;
      --bg:         #FFFFFF;
      --bg-warm:    #FDF8F0;
      --bg-section: #F7F7F5;
    }

    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: var(--black);
      background: var(--bg-section);
      -webkit-font-smoothing: antialiased;
    }

    /* ── MASTHEAD ───────────────────────────────────── */
    .masthead {
      background: var(--black);
      text-align: center;
      flex-shrink: 0;
    }

    .masthead-inner {
      max-width: 100%;
      padding: 16px 20px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .masthead-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .masthead-back {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      transition: color 0.15s;
    }

    .masthead-back:hover { color: #ccc; }

    .masthead-sep {
      color: #444;
      font-size: 14px;
    }

    .masthead-brand {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.5px;
    }

    .masthead-edition {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #888;
      letter-spacing: 0.5px;
    }

    .masthead-ts {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #666;
    }

    /* ── NAV ────────────────────────────────────────── */
    .nav {
      background: var(--black);
      border-top: 1px solid #222;
      border-bottom: 3px solid var(--red);
      flex-shrink: 0;
    }

    .nav-inner {
      padding: 0 20px;
      display: flex;
    }

    .nav-tab {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      padding: 10px 16px 9px;
      border-bottom: 3px solid transparent;
      transition: color 0.15s;
    }

    .nav-tab:hover { color: #ccc; }

    .nav-tab.active {
      color: #fff;
      border-bottom-color: var(--red);
    }

    /* ── LAYOUT ─────────────────────────────────────── */
    .layout-wrapper {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    .layout {
      display: flex;
      flex: 1;
      min-height: 0;
    }

    /* ── NEWSLETTER PANE ─────────────────────────────── */
    .newsletter-pane {
      flex: 1 1 0;
      min-width: 0;
    }

    .newsletter-pane iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    /* ── SIDEBAR ────────────────────────────────────── */
    .sidebar {
      width: 272px;
      flex-shrink: 0;
      background: var(--bg);
      border-left: 1px solid var(--border);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar-header {
      background: var(--black);
      padding: 16px 20px;
      position: sticky;
      top: 0;
      z-index: 1;
      border-bottom: 2px solid var(--red);
    }

    .sidebar-header-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 3px 0;
    }

    .sidebar-header-meta {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #888;
    }

    .sidebar-body {
      padding: 16px;
      flex: 1;
    }

    /* ── SOURCE GROUPS ──────────────────────────────── */
    .source-group {
      margin-bottom: 20px;
    }

    .source-group:last-child { margin-bottom: 0; }

    .source-name {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--black);
      margin: 0 0 8px 0;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .source-count {
      background: var(--red);
      color: #fff;
      font-size: 9px;
      font-weight: 700;
      padding: 2px 6px;
      letter-spacing: 0.5px;
    }

    .article-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .article-list li {
      margin-bottom: 6px;
      font-size: 12px;
      line-height: 1.4;
    }

    .article-list a {
      color: var(--charcoal);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s, color 0.15s;
    }

    .article-list a:hover {
      color: var(--red);
      border-bottom-color: var(--red);
    }

    /* ── EMPTY STATE ────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 40px 16px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: var(--gray-mid);
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="layout-wrapper">

    <!-- ── MASTHEAD ─────────────────────────────────── -->
    <header class="masthead">
      <div class="masthead-inner">
        <div class="masthead-left">
          <a class="masthead-back" href="/">&larr; Dashboard</a>
          <span class="masthead-sep">/</span>
          <span class="masthead-brand">The Agentic Times</span>
          <span class="masthead-edition">Edition {{ run_id[:8] }}&hellip;</span>
        </div>
        {% if started_at %}
        <span class="masthead-ts">{{ started_at }}</span>
        {% endif %}
      </div>
    </header>

    <!-- ── NAV ─────────────────────────────────────── -->
    <nav class="nav">
      <div class="nav-inner">
        <a class="nav-tab" href="/">Run History</a>
        <a class="nav-tab" href="/metrics">Metrics</a>
      </div>
    </nav>

    <!-- ── SPLIT LAYOUT ─────────────────────────────── -->
    <div class="layout">

      <!-- Newsletter iframe -->
      <div class="newsletter-pane">
        <iframe src="/runs/{{ run_id }}/newsletter" title="Newsletter Edition"></iframe>
      </div>

      <!-- Sources sidebar -->
      <aside class="sidebar">
        <div class="sidebar-header">
          <h2 class="sidebar-header-title">Articles by Source</h2>
          <p class="sidebar-header-meta">
            {{ sources | length }} source{{ 's' if sources | length != 1 else '' }}
            &mdash;
            {{ sources.values() | map('length') | sum }} fetched
          </p>
        </div>

        <div class="sidebar-body">
          {% if sources %}
            {% for publication, articles in sources.items() %}
            <div class="source-group">
              <h3 class="source-name">
                <span>{{ publication }}</span>
                <span class="source-count">{{ articles | length }}</span>
              </h3>
              <ul class="article-list">
                {% for article in articles %}
                <li>
                  <a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a>
                </li>
                {% endfor %}
              </ul>
            </div>
            {% endfor %}
          {% else %}
            <div class="empty-state">No article data for this edition.</div>
          {% endif %}
        </div>
      </aside>

    </div>
  </div>
</body>
</html>
