{% extends "_base_admin.html.jinja2" %}

{% block head_title %}The Agentic Times &mdash; Dashboard{% endblock %}

{% block masthead_tagline %}AI News &amp; Analysis &nbsp;&middot;&nbsp; Pipeline Dashboard{% endblock %}

{% block extra_css %}
    /* ── CONTROLS CARD ──────────────────────────────── */
    .controls-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 28px 32px;
      margin-bottom: 32px;
    }

    .controls-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--black);
      margin: 0 0 4px 0;
    }

    .controls-subtitle {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: var(--gray-dark);
      margin: 0 0 20px 0;
    }

    .controls-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 0 0 24px 0;
    }

    .controls-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
    }

    /* ── BUTTONS ────────────────────────────────────── */
    .btn-primary {
      background: var(--red);
      color: #fff;
      border: none;
      padding: 11px 28px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-primary:hover:not(:disabled) { background: #9c0e24; }
    .btn-primary:disabled { background: var(--gray-light); cursor: not-allowed; }

    .btn-secondary {
      background: transparent;
      color: var(--black);
      border: 1.5px solid var(--black);
      padding: 10px 28px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }

    .btn-secondary:hover:not(:disabled) {
      background: var(--black);
      color: #fff;
    }
    .btn-secondary:disabled {
      border-color: var(--gray-light);
      color: var(--gray-light);
      cursor: not-allowed;
    }

    /* ── RUNNING BADGE ──────────────────────────────── */
    .running-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--red);
      border: 1px solid var(--red);
      background: #FFF5F5;
      padding: 6px 12px;
    }

    .running-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--red);
      animation: pulse 1.4s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    /* ── HISTORY CARD ───────────────────────────────── */
    .history-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
    }

    /* ── TABLE ──────────────────────────────────────── */
    .runs-table {
      width: 100%;
      border-collapse: collapse;
    }

    .runs-table thead tr {
      background: var(--bg-section);
      border-bottom: 1px solid var(--border);
    }

    .runs-table thead th {
      padding: 12px 20px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      text-align: left;
    }

    .runs-table tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.1s;
    }

    .runs-table tbody tr:last-child { border-bottom: none; }
    .runs-table tbody tr:hover { background: var(--bg-warm); }

    .runs-table td {
      padding: 16px 20px;
      font-size: 13px;
      vertical-align: middle;
    }

    /* ── STATUS BADGES ──────────────────────────────── */
    .badge {
      display: inline-block;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 4px 9px;
    }

    .badge-success { background: #E6F4E6; color: #1A5C1A; }
    .badge-running { background: #FFF5F5; color: var(--red); }
    .badge-error   { background: #FDE8E8; color: #921818; }

    .error-msg {
      margin-top: 6px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #921818;
      background: #FDE8E8;
      border-left: 2px solid #921818;
      padding: 5px 9px;
    }

    /* ── TABLE TYPOGRAPHY ───────────────────────────── */
    .ts {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: var(--gray-dark);
    }

    .duration {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: var(--gray-mid);
    }

    .article-count {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 16px;
      font-weight: 700;
      color: var(--black);
    }

    .view-link {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: var(--red);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s;
    }

    .view-link:hover { border-bottom-color: var(--red); }

    /* ── TOPBAR DATE / RUNNING ──────────────────────── */
    .topbar-date {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #AAAAAA;
      font-style: italic;
    }

    /* ── EMPTY STATE ────────────────────────────────── */
    .empty-state {
      padding: 60px 20px;
      text-align: center;
    }

    .empty-state-headline {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--charcoal);
      margin-bottom: 10px;
    }

    .empty-state-body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: var(--gray-mid);
    }

    /* ── RESPONSIVE ─────────────────────────────────── */
    @media (max-width: 620px) {
      .controls-card { padding: 20px; }
      .controls-actions { flex-direction: column; align-items: stretch; }
      .btn-primary, .btn-secondary { width: 100%; text-align: center; }
      .topbar-inner { flex-wrap: wrap; gap: 6px; }
    }
{% endblock %}

{% block topbar %}
  <div class="topbar">
    <div class="topbar-inner">
      <span class="topbar-date">{{ run_time.strftime('%A, %B %-d, %Y') if run_time else 'Dashboard' }}</span>
      {% if running %}
      <div class="running-badge">
        <div class="running-dot"></div>
        Run in Progress
      </div>
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block main_content %}
    <!-- Operations Desk -->
    <div class="controls-card">
      <h2 class="controls-title">Operations Desk</h2>
      <p class="controls-subtitle">Trigger a new pipeline run to fetch, rank, and deliver the latest AI news.</p>
      <hr class="controls-rule" />
      <div class="controls-actions">
        <button
          type="button"
          class="btn-primary"
          title="Fetch new articles not seen before and send the newsletter"
          onclick="triggerRun(false)"
          {% if running %}disabled{% endif %}
        >&#9654;&nbsp; Run Now</button>
        <button
          type="button"
          class="btn-secondary"
          title="Clears articles seen in the last 12 hours from the dedup cache, then runs the pipeline"
          onclick="triggerRun(true)"
          {% if running %}disabled{% endif %}
        >&#8635;&nbsp; Clean Run</button>
        {% if running %}
        <div class="running-badge">
          <div class="running-dot"></div>
          Run in Progress &mdash; Please Wait
        </div>
        {% endif %}
      </div>
    </div>

    <!-- Run History -->
    <h2 class="section-label">
      <span class="section-label-accent">Latest</span>
      Run History
    </h2>

    <div class="history-card">
      {% if runs %}
      <table class="runs-table">
        <thead>
          <tr>
            <th>Started</th>
            <th>Status</th>
            <th>Articles</th>
            <th title="Articles that were fetched but dropped due to a relevance score below the threshold">Dropped</th>
            <th title="Articles that failed LLM processing due to API errors or timeouts">Failed</th>
            <th>Duration</th>
            <th>Edition</th>
          </tr>
        </thead>
        <tbody>
          {% for run in runs %}
          <tr>
            <td><span class="ts">{{ run.started_at_display }}</span></td>

            <td>
              {% if run.status == 'success' %}
                <span class="badge badge-success">Success</span>
              {% elif run.status == 'running' %}
                <span class="badge badge-running">Running</span>
              {% else %}
                <span class="badge badge-error">Error</span>
              {% endif %}
              {% if run.status == 'error' and run.error %}
                <div class="error-msg">{{ run.error }}</div>
              {% endif %}
            </td>

            <td>
              <span class="article-count">
                {% if run.article_count is not none %}{{ run.article_count }}{% else %}&mdash;{% endif %}
              </span>
            </td>

            <td>
              <span class="article-count">{{ run.dropped_count if run.dropped_count is not none else 0 }}</span>
            </td>

            <td>
              <span class="article-count">{{ run.failed_count if run.failed_count is not none else 0 }}</span>
            </td>

            <td>
              <span class="duration">{{ run.duration_display }}</span>
            </td>

            <td>
              {% if run.status == 'success' %}
                <a class="view-link" href="/runs/{{ run.id }}">View Edition &rarr;</a>
              {% else %}
                &mdash;
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="empty-state">
        <div class="empty-state-headline">No Editions Yet</div>
        <div class="empty-state-body">Click <strong>Run Now</strong> to generate your first newsletter.</div>
      </div>
      {% endif %}
    </div>
{% endblock %}

{% block scripts %}
  <script>
    let pollingInterval = null;
    let activeRunId = null;

    function triggerRun(clean) {
      const url = clean ? '/run?clean=true' : '/run';
      fetch(url, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          activeRunId = data.run_id;
          insertOptimisticRow();
          showRunningBadges();
          disableButtons();
          startPolling();
        })
        .catch(() => showErrorMessage('Failed to start run. Please try again.'));
    }

    function insertOptimisticRow() {
      const tbody = document.querySelector('.runs-table tbody');
      if (!tbody) return;
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><span class="ts">Just now…</span></td>
        <td><span class="badge badge-running">Running</span></td>
        <td><span class="article-count">&mdash;</span></td>
        <td><span class="article-count">&mdash;</span></td>
        <td><span class="article-count">&mdash;</span></td>
        <td><span class="duration">&mdash;</span></td>
        <td>&mdash;</td>
      `;
      tbody.prepend(row);
    }

    function showRunningBadges() {
      document.querySelectorAll('.running-badge').forEach(el => el.style.display = 'inline-flex');
    }

    function hideRunningBadges() {
      document.querySelectorAll('.running-badge').forEach(el => el.style.display = 'none');
    }

    function disableButtons() {
      document.querySelectorAll('.btn-primary, .btn-secondary').forEach(btn => btn.disabled = true);
    }

    function enableButtons() {
      document.querySelectorAll('.btn-primary, .btn-secondary').forEach(btn => btn.disabled = false);
    }

    function startPolling() {
      stopPolling();
      pollingInterval = setInterval(() => {
        fetch('/runs')
          .then(r => r.json())
          .then(data => {
            renderRuns(data);
            if (!data.some(run => run.status === 'running')) {
              stopPolling();
              hideRunningBadges();
              enableButtons();
              activeRunId = null;
            }
          })
          .catch(() => {});
      }, 3000);
    }

    function stopPolling() {
      if (pollingInterval !== null) { clearInterval(pollingInterval); pollingInterval = null; }
    }

    function renderRuns(runs) {
      const tbody = document.querySelector('.runs-table tbody');
      if (!tbody) return;
      tbody.innerHTML = '';

      runs.forEach(run => {
        const row = document.createElement('tr');

        const startedTd = document.createElement('td');
        startedTd.innerHTML = `<span class="ts">${run.started_at_display || run.started_at}</span>`;
        row.appendChild(startedTd);

        const statusTd = document.createElement('td');
        let cls = 'badge-success', lbl = 'Success';
        if (run.status === 'running') { cls = 'badge-running'; lbl = 'Running'; }
        else if (run.status === 'error') { cls = 'badge-error'; lbl = 'Error'; }
        statusTd.innerHTML = `<span class="badge ${cls}">${lbl}</span>`;
        if (run.status === 'error' && run.error) {
          const d = document.createElement('div');
          d.className = 'error-msg'; d.textContent = run.error;
          statusTd.appendChild(d);
        }
        row.appendChild(statusTd);

        const artTd = document.createElement('td');
        artTd.innerHTML = `<span class="article-count">${run.article_count !== null ? run.article_count : '&mdash;'}</span>`;
        row.appendChild(artTd);

        const droppedTd = document.createElement('td');
        droppedTd.innerHTML = `<span class="article-count">${run.dropped_count !== null && run.dropped_count !== undefined ? run.dropped_count : 0}</span>`;
        row.appendChild(droppedTd);

        const failedTd = document.createElement('td');
        failedTd.innerHTML = `<span class="article-count">${run.failed_count !== null && run.failed_count !== undefined ? run.failed_count : 0}</span>`;
        row.appendChild(failedTd);

        const durTd = document.createElement('td');
        durTd.innerHTML = `<span class="duration">${run.duration_display || '&mdash;'}</span>`;
        row.appendChild(durTd);

        const linkTd = document.createElement('td');
        linkTd.innerHTML = run.status === 'success'
          ? `<a class="view-link" href="/runs/${run.id}">View Edition &rarr;</a>`
          : '&mdash;';
        row.appendChild(linkTd);

        tbody.appendChild(row);
      });

      if (activeRunId && !runs.some(r => r.id === activeRunId)) {
        insertOptimisticRow();
      }
    }

    function showErrorMessage(message) {
      const existing = document.querySelector('.error-msg.global');
      if (existing) existing.remove();
      const d = document.createElement('div');
      d.className = 'error-msg global';
      d.style.cssText = 'margin-top:12px;padding:8px 12px;';
      d.textContent = message;
      const actions = document.querySelector('.controls-actions');
      if (actions) {
        actions.appendChild(d);
        setTimeout(() => { if (d.parentNode) d.remove(); }, 3500);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const badge = document.querySelector('.running-badge');
      if (badge && getComputedStyle(badge).display !== 'none') startPolling();
    });
  </script>
{% endblock %}
