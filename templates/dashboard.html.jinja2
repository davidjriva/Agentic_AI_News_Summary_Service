<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Agentic Times &mdash; Dashboard</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --black:       #121212;
      --charcoal:    #333333;
      --red:         #C41230;
      --gray-dark:   #555555;
      --gray-mid:    #888888;
      --gray-light:  #CCCCCC;
      --border:      #DEDEDE;
      --bg:          #FFFFFF;
      --bg-warm:     #FDF8F0;
      --bg-section:  #F7F7F5;
    }

    body {
      margin: 0;
      padding: 0;
      background: var(--bg-section);
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: var(--black);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── MASTHEAD ───────────────────────────────────── */
    .masthead {
      background: var(--black);
      text-align: center;
    }

    .masthead-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 28px 20px 20px;
    }

    .masthead-eyebrow {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--gray-light);
      margin-bottom: 10px;
    }

    .masthead-rule {
      border: none;
      border-top: 1px solid #3a3a3a;
      margin: 10px auto 14px;
      width: 300px;
    }

    .masthead-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 48px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -1px;
      line-height: 1;
      margin: 0;
    }

    .masthead-tagline {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #999;
      margin-top: 14px;
    }

    /* ── TOP BAR ────────────────────────────────────── */
    .topbar {
      background: var(--black);
      border-top: 1px solid #222;
      border-bottom: 3px solid var(--red);
    }

    .topbar-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 8px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .topbar-date {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #AAAAAA;
      font-style: italic;
    }

    /* ── NAV ────────────────────────────────────────── */
    .nav {
      background: var(--black);
      border-bottom: 1px solid #222;
    }

    .nav-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
    }

    .nav-tab {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #888;
      text-decoration: none;
      padding: 11px 16px 10px;
      border-bottom: 3px solid transparent;
      transition: color 0.15s;
    }

    .nav-tab:hover { color: #ccc; }

    .nav-tab.active {
      color: #FFFFFF;
      border-bottom-color: var(--red);
    }

    /* ── PAGE WRAPPER ───────────────────────────────── */
    .page-wrapper {
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }

    /* ── SECTION LABEL ──────────────────────────────── */
    .section-label {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--gray-dark);
      margin: 0 0 20px 0;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--black);
      display: flex;
      align-items: center;
    }

    .section-label-accent {
      display: inline-block;
      background: var(--red);
      color: #fff;
      font-size: 9px;
      letter-spacing: 1.5px;
      padding: 3px 8px;
      margin-right: 10px;
    }

    /* ── CONTROLS CARD ──────────────────────────────── */
    .controls-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
      padding: 28px 32px;
      margin-bottom: 32px;
    }

    .controls-title {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--black);
      margin: 0 0 4px 0;
    }

    .controls-subtitle {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: var(--gray-dark);
      margin: 0 0 20px 0;
    }

    .controls-rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 0 0 24px 0;
    }

    .controls-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
    }

    /* ── BUTTONS ────────────────────────────────────── */
    .btn-primary {
      background: var(--red);
      color: #fff;
      border: none;
      padding: 11px 28px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-primary:hover:not(:disabled) { background: #9c0e24; }
    .btn-primary:disabled { background: var(--gray-light); cursor: not-allowed; }

    .btn-secondary {
      background: transparent;
      color: var(--black);
      border: 1.5px solid var(--black);
      padding: 10px 28px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }

    .btn-secondary:hover:not(:disabled) {
      background: var(--black);
      color: #fff;
    }
    .btn-secondary:disabled {
      border-color: var(--gray-light);
      color: var(--gray-light);
      cursor: not-allowed;
    }

    /* ── RUNNING BADGE ──────────────────────────────── */
    .running-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--red);
      border: 1px solid var(--red);
      background: #FFF5F5;
      padding: 6px 12px;
    }

    .running-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--red);
      animation: pulse 1.4s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    /* ── HISTORY CARD ───────────────────────────────── */
    .history-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--black);
    }

    /* ── TABLE ──────────────────────────────────────── */
    .runs-table {
      width: 100%;
      border-collapse: collapse;
    }

    .runs-table thead tr {
      background: var(--bg-section);
      border-bottom: 1px solid var(--border);
    }

    .runs-table thead th {
      padding: 12px 20px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--gray-dark);
      text-align: left;
    }

    .runs-table thead th.col-num,
    .runs-table tbody td.col-num {
      text-align: right;
    }

    .runs-table tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.1s;
    }

    .runs-table tbody tr:last-child { border-bottom: none; }
    .runs-table tbody tr:hover { background: var(--bg-warm); }

    .runs-table td {
      padding: 16px 20px;
      font-size: 13px;
      vertical-align: middle;
    }

    /* ── STATUS BADGES ──────────────────────────────── */
    .badge {
      display: inline-block;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 4px 9px;
    }

    .badge-success { background: #E6F4E6; color: #1A5C1A; }
    .badge-running { background: #FFF5F5; color: var(--red); }
    .badge-error   { background: #FDE8E8; color: #921818; }

    .error-msg {
      margin-top: 6px;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #921818;
      background: #FDE8E8;
      border-left: 2px solid #921818;
      padding: 5px 9px;
    }

    /* ── TABLE TYPOGRAPHY ───────────────────────────── */
    .ts {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: var(--gray-dark);
    }

    .duration {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: var(--gray-mid);
    }

    .article-count {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 16px;
      font-weight: 700;
      color: var(--black);
    }

    .secondary-count {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: var(--gray-mid);
    }

    .view-link {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: var(--red);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s;
    }

    .view-link:hover { border-bottom-color: var(--red); }

    /* ── EMPTY STATE ────────────────────────────────── */
    .empty-state {
      padding: 60px 20px;
      text-align: center;
    }

    .empty-state-headline {
      font-family: Georgia, 'Times New Roman', Times, serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--charcoal);
      margin-bottom: 10px;
    }

    .empty-state-body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 13px;
      color: var(--gray-mid);
    }

    /* ── FOOTER ─────────────────────────────────────── */
    .footer {
      background: var(--black);
      padding: 24px 20px;
      text-align: center;
    }

    .footer-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .footer p {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #666;
      margin: 0 0 4px 0;
      letter-spacing: 0.3px;
    }

    .footer p:last-child { margin-bottom: 0; }
    .footer a { color: #888; text-decoration: none; }
    .footer a:hover { color: #aaa; }

    /* ── RESPONSIVE ─────────────────────────────────── */
    @media (max-width: 620px) {
      .masthead-title { font-size: 32px; }
      .page-wrapper { padding: 20px 16px 40px; }
      .controls-card { padding: 20px; }
      .controls-actions { flex-direction: column; align-items: stretch; }
      .btn-primary, .btn-secondary { width: 100%; text-align: center; }
      .topbar-inner { flex-wrap: wrap; gap: 6px; }
    }
  </style>
</head>
<body>

  <!-- ── MASTHEAD ─────────────────────────────────────── -->
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-eyebrow">Est. 2026 &nbsp;&middot;&nbsp; Automated Edition</div>
      <hr class="masthead-rule" />
      <h1 class="masthead-title">The Agentic Times</h1>
      <hr class="masthead-rule" />
      <div class="masthead-tagline">AI News &amp; Analysis &nbsp;&middot;&nbsp; Pipeline Dashboard</div>
    </div>
  </header>

  <!-- ── TOP BAR ───────────────────────────────────────── -->
  <div class="topbar">
    <div class="topbar-inner">
      <span class="topbar-date">{{ run_time.strftime('%A, %B %-d, %Y') if run_time else 'Dashboard' }}</span>
      {% if running %}
      <div class="running-badge">
        <div class="running-dot"></div>
        Run in Progress
      </div>
      {% endif %}
    </div>
  </div>

  <!-- ── NAV ───────────────────────────────────────────── -->
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-tab {% if active == 'dashboard' %}active{% endif %}" href="/">Run History</a>
      <a class="nav-tab {% if active == 'metrics' %}active{% endif %}" href="/metrics">Metrics</a>
    </div>
  </nav>

  <!-- ── CONTENT ───────────────────────────────────────── -->
  <main class="page-wrapper">

    <!-- Operations Desk -->
    <div class="controls-card">
      <h2 class="controls-title">Operations Desk</h2>
      <p class="controls-subtitle">Fetch, rank, and deliver the latest AI news to all subscribers.</p>
      <hr class="controls-rule" />
      <div class="controls-actions">
        <button
          type="button"
          class="btn-primary"
          title="Fetch new articles not seen before and send the newsletter"
          onclick="triggerRun(false)"
          {% if running %}disabled{% endif %}
        >&#9654;&nbsp; Run Now</button>
        <button
          type="button"
          class="btn-secondary"
          title="Clears articles seen in the last 12 hours from the dedup cache, then runs the pipeline"
          onclick="triggerRun(true)"
          {% if running %}disabled{% endif %}
        >&#8635;&nbsp; Clean Run</button>
        {% if running %}
        <div class="running-badge">
          <div class="running-dot"></div>
          Run in Progress &mdash; Please Wait
        </div>
        {% endif %}
      </div>
    </div>

    <!-- Run History -->
    <h2 class="section-label">
      <span class="section-label-accent">Latest</span>
      Run History
    </h2>

    <div class="history-card">
      {% if runs %}
      <table class="runs-table">
        <thead>
          <tr>
            <th>Started</th>
            <th>Status</th>
            <th class="col-num">Articles</th>
            <th class="col-num">Dropped</th>
            <th class="col-num">Failed</th>
            <th class="col-num">Duration</th>
            <th>Edition</th>
          </tr>
        </thead>
        <tbody>
          {% for run in runs %}
          <tr>
            <td><span class="ts" data-iso="{{ run.started_at }}">{{ run.started_at }}</span></td>

            <td>
              {% if run.status == 'success' %}
                <span class="badge badge-success">Success</span>
              {% elif run.status == 'running' %}
                <span class="badge badge-running">Running</span>
              {% else %}
                <span class="badge badge-error">Error</span>
              {% endif %}
              {% if run.status == 'error' and run.error %}
                <div class="error-msg">{{ run.error }}</div>
              {% endif %}
            </td>

            <td class="col-num">
              <span class="article-count">
                {% if run.article_count is not none %}{{ run.article_count }}{% else %}&mdash;{% endif %}
              </span>
            </td>

            <td class="col-num">
              <span class="secondary-count">{{ run.dropped_count if run.dropped_count is not none else 0 }}</span>
            </td>

            <td class="col-num">
              <span class="secondary-count">{{ run.failed_count if run.failed_count is not none else 0 }}</span>
            </td>

            <td class="col-num">
              <span class="duration">
                {% if run.started_at and run.completed_at %}
                  {% set start_parts = run.started_at.replace('T', ' ').split(' ') %}
                  {% set end_parts = run.completed_at.replace('T', ' ').split(' ') %}
                  {% set start_time = start_parts[1].split('.')[0].split(':') %}
                  {% set end_time = end_parts[1].split('.')[0].split(':') %}
                  {% set start_secs = start_time[0]|int * 3600 + start_time[1]|int * 60 + start_time[2]|int %}
                  {% set end_secs = end_time[0]|int * 3600 + end_time[1]|int * 60 + end_time[2]|int %}
                  {% set diff = end_secs - start_secs %}
                  {% if diff < 0 %}{% set diff = diff + 86400 %}{% endif %}
                  {% if diff >= 60 %}{{ (diff // 60)|int }}m {{ (diff % 60)|int }}s
                  {% else %}{{ diff }}s{% endif %}
                {% else %}&mdash;{% endif %}
              </span>
            </td>

            <td>
              {% if run.status == 'success' %}
                <a class="view-link" href="/runs/{{ run.id }}">View Edition &rarr;</a>
              {% else %}
                &mdash;
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="empty-state">
        <div class="empty-state-headline">No Editions Yet</div>
        <div class="empty-state-body">Click <strong>Run Now</strong> to generate your first newsletter.</div>
      </div>
      {% endif %}
    </div>

  </main>

  <!-- ── FOOTER ────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer-inner">
      <p>The Agentic Times &mdash; Automated AI News Digest</p>
      <p><a href="http://localhost:8000">http://localhost:8000</a></p>
    </div>
  </footer>

  <script>
    let pollingInterval = null;
    let activeRunId = null;

    function triggerRun(clean) {
      const url = clean ? '/run?clean=true' : '/run';
      fetch(url, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          activeRunId = data.run_id;
          insertOptimisticRow();
          showRunningBadges();
          disableButtons();
          startPolling();
        })
        .catch(() => showErrorMessage('Failed to start run. Please try again.'));
    }

    function insertOptimisticRow() {
      const tbody = document.querySelector('.runs-table tbody');
      if (!tbody) return;
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><span class="ts">Just now\u2026</span></td>
        <td><span class="badge badge-running">Running</span></td>
        <td><span class="article-count">&mdash;</span></td>
        <td><span class="article-count">&mdash;</span></td>
        <td><span class="article-count">&mdash;</span></td>
        <td><span class="duration">&mdash;</span></td>
        <td>&mdash;</td>
      `;
      tbody.prepend(row);
    }

    function showRunningBadges() {
      document.querySelectorAll('.running-badge').forEach(el => el.style.display = 'inline-flex');
    }

    function hideRunningBadges() {
      document.querySelectorAll('.running-badge').forEach(el => el.style.display = 'none');
    }

    function disableButtons() {
      document.querySelectorAll('.btn-primary, .btn-secondary').forEach(btn => btn.disabled = true);
    }

    function enableButtons() {
      document.querySelectorAll('.btn-primary, .btn-secondary').forEach(btn => btn.disabled = false);
    }

    function startPolling() {
      stopPolling();
      pollingInterval = setInterval(() => {
        fetch('/runs')
          .then(r => r.json())
          .then(data => {
            renderRuns(data);
            if (!data.some(run => run.status === 'running')) {
              stopPolling();
              hideRunningBadges();
              enableButtons();
              activeRunId = null;
            }
          })
          .catch(() => {});
      }, 3000);
    }

    function stopPolling() {
      if (pollingInterval !== null) { clearInterval(pollingInterval); pollingInterval = null; }
    }

    function renderRuns(runs) {
      const tbody = document.querySelector('.runs-table tbody');
      if (!tbody) return;
      tbody.innerHTML = '';

      runs.forEach(run => {
        const row = document.createElement('tr');

        const startedTd = document.createElement('td');
        startedTd.innerHTML = `<span class="ts">${formatISODate(run.started_at)}</span>`;
        row.appendChild(startedTd);

        const statusTd = document.createElement('td');
        let cls = 'badge-success', lbl = 'Success';
        if (run.status === 'running') { cls = 'badge-running'; lbl = 'Running'; }
        else if (run.status === 'error') { cls = 'badge-error'; lbl = 'Error'; }
        statusTd.innerHTML = `<span class="badge ${cls}">${lbl}</span>`;
        if (run.status === 'error' && run.error) {
          const d = document.createElement('div');
          d.className = 'error-msg'; d.textContent = run.error;
          statusTd.appendChild(d);
        }
        row.appendChild(statusTd);

        const artTd = document.createElement('td');
        artTd.className = 'col-num';
        artTd.innerHTML = `<span class="article-count">${run.article_count !== null ? run.article_count : '&mdash;'}</span>`;
        row.appendChild(artTd);

        const droppedTd = document.createElement('td');
        droppedTd.className = 'col-num';
        droppedTd.innerHTML = `<span class="secondary-count">${run.dropped_count !== null && run.dropped_count !== undefined ? run.dropped_count : 0}</span>`;
        row.appendChild(droppedTd);

        const failedTd = document.createElement('td');
        failedTd.className = 'col-num';
        failedTd.innerHTML = `<span class="secondary-count">${run.failed_count !== null && run.failed_count !== undefined ? run.failed_count : 0}</span>`;
        row.appendChild(failedTd);

        const durTd = document.createElement('td');
        let dur = '&mdash;';
        if (run.started_at && run.completed_at) {
          const sp = run.started_at.replace('T',' ').split(' ');
          const ep = run.completed_at.replace('T',' ').split(' ');
          const st = sp[1].split('.')[0].split(':');
          const et = ep[1].split('.')[0].split(':');
          const ss = +st[0]*3600 + +st[1]*60 + +st[2];
          const es = +et[0]*3600 + +et[1]*60 + +et[2];
          let d = es - ss; if (d < 0) d += 86400;
          dur = d >= 60 ? `${Math.floor(d/60)}m ${d%60}s` : `${d}s`;
        }
        durTd.className = 'col-num';
        durTd.innerHTML = `<span class="duration">${dur}</span>`;
        row.appendChild(durTd);

        const linkTd = document.createElement('td');
        linkTd.innerHTML = run.status === 'success'
          ? `<a class="view-link" href="/runs/${run.id}">View Edition &rarr;</a>`
          : '&mdash;';
        row.appendChild(linkTd);

        tbody.appendChild(row);
      });

      if (activeRunId && !runs.some(r => r.id === activeRunId)) {
        insertOptimisticRow();
      }
    }

    function showErrorMessage(message) {
      const existing = document.querySelector('.error-msg.global');
      if (existing) existing.remove();
      const d = document.createElement('div');
      d.className = 'error-msg global';
      d.style.cssText = 'margin-top:12px;padding:8px 12px;';
      d.textContent = message;
      const actions = document.querySelector('.controls-actions');
      if (actions) {
        actions.appendChild(d);
        setTimeout(() => { if (d.parentNode) d.remove(); }, 3500);
      }
    }

    function formatISODate(iso) {
      if (!iso) return iso;
      try {
        const d = new Date(iso.replace(' ', 'T'));
        if (isNaN(d)) return iso;
        return d.toLocaleString('en-US', {
          month: 'short', day: 'numeric', year: 'numeric',
          hour: 'numeric', minute: '2-digit', hour12: true,
          timeZone: 'UTC', timeZoneName: 'short'
        });
      } catch { return iso; }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.ts[data-iso]').forEach(el => {
        el.textContent = formatISODate(el.dataset.iso);
      });
      const badge = document.querySelector('.running-badge');
      if (badge && getComputedStyle(badge).display !== 'none') startPolling();
    });
  </script>
</body>
</html>
